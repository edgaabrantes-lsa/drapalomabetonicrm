{
  "name": "SensorFlowConvite",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "ID interno do paciente vinculado ao convite"
    },
    "patient_name": {
      "type": "string"
    },
    "token": {
      "type": "string",
      "description": "Token seguro, \u00fanico e n\u00e3o previs\u00edvel"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando",
        "respondido",
        "expirado",
        "cancelado"
      ],
      "default": "aguardando"
    },
    "gerado_por": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que gerou o convite"
    },
    "gerado_por_id": {
      "type": "string"
    },
    "data_criacao": {
      "type": "string",
      "format": "date-time"
    },
    "data_validade": {
      "type": "string",
      "format": "date-time"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date-time"
    },
    "data_preenchimento": {
      "type": "string",
      "format": "date-time"
    },
    "resposta_id": {
      "type": "string",
      "description": "ID do PerfilSensorial relacionado \u00e0 resposta"
    },
    "lgpd_consent": {
      "type": "boolean",
      "default": false
    },
    "lgpd_consent_date": {
      "type": "string",
      "format": "date-time"
    },
    "lgpd_consent_version": {
      "type": "string"
    },
    "dispositivo": {
      "type": "string"
    },
    "navegador": {
      "type": "string"
    },
    "url_origem": {
      "type": "string"
    },
    "cancelado_por": {
      "type": "string"
    },
    "data_cancelamento": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_cancelamento": {
      "type": "string"
    },
    "historico": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "acao": {
            "type": "string"
          },
          "data": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "patient_id",
    "token",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}