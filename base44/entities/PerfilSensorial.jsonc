{
  "name": "PerfilSensorial",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "convite_id": {
      "type": "string",
      "description": "ID do convite do Sensor Flow que originou esta resposta"
    },
    "submission_id": {
      "type": "string"
    },
    "appointment_periods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "music_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Estilos musicais preferidos pela paciente"
    },
    "music_other": {
      "type": "string",
      "description": "Outro estilo musical informado pela paciente"
    },
    "wants_music_choice": {
      "type": "boolean",
      "default": false,
      "description": "Se a paciente deseja escolher m\u00fasica/cantor para o atendimento"
    },
    "music_choice_song": {
      "type": "string",
      "description": "M\u00fasica que a paciente gostaria de ouvir"
    },
    "music_choice_artist": {
      "type": "string",
      "description": "Cantor/cantora/banda preferida pela paciente"
    },
    "beverage_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "beverage_other": {
      "type": "string",
      "description": "Outra bebida informada pela paciente"
    },
    "food_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "food_other": {
      "type": "string",
      "description": "Outro alimento informado pela paciente"
    },
    "dietary_restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dietary_restrictions_detail": {
      "type": "string",
      "description": "Detalhamento de alergias, intoler\u00e2ncias ou restri\u00e7\u00f5es"
    },
    "environment_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "temperature_preference": {
      "type": "string"
    },
    "likes_aromas": {
      "type": "boolean",
      "default": false
    },
    "aroma_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aroma_other": {
      "type": "string",
      "description": "Outro aroma informado pela paciente"
    },
    "service_style": {
      "type": "string"
    },
    "hospitality_summary": {
      "type": "string"
    },
    "lgpd_consent": {
      "type": "boolean",
      "default": false
    },
    "lgpd_consent_date": {
      "type": "string",
      "format": "date-time"
    },
    "lgpd_consent_version": {
      "type": "string"
    },
    "form_source": {
      "type": "string",
      "default": "SensorlyFlow"
    },
    "url_origem": {
      "type": "string"
    },
    "dispositivo": {
      "type": "string"
    },
    "navegador": {
      "type": "string"
    },
    "crm_status": {
      "type": "string"
    }
  },
  "required": [
    "patient_id"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}