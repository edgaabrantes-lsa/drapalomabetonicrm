{
  "name": "Receita",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "ID do paciente (Patient)"
    },
    "patient_name": {
      "type": "string"
    },
    "patient_birth_date": {
      "type": "string",
      "format": "date"
    },
    "data_emissao": {
      "type": "string",
      "format": "date"
    },
    "tipo_receita": {
      "type": "string",
      "enum": [
        "simples",
        "controle_especial"
      ],
      "default": "simples",
      "enumColors": [
        "green",
        "red"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "emitida",
        "cancelada",
        "substituida"
      ],
      "default": "rascunho",
      "enumColors": [
        "gray",
        "green",
        "red",
        "yellow"
      ]
    },
    "medicamentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "apresentacao": {
            "type": "string"
          },
          "dose": {
            "type": "string"
          },
          "via": {
            "type": "string"
          },
          "frequencia": {
            "type": "string"
          },
          "duracao": {
            "type": "string"
          },
          "quantidade": {
            "type": "string"
          },
          "orientacoes": {
            "type": "string"
          }
        }
      }
    },
    "orientacoes_gerais": {
      "type": "string"
    },
    "profissional_id": {
      "type": "string"
    },
    "profissional_nome": {
      "type": "string"
    },
    "profissional_profissao": {
      "type": "string"
    },
    "profissional_conselho": {
      "type": "string"
    },
    "profissional_registro": {
      "type": "string"
    },
    "assinatura_url": {
      "type": "string",
      "description": "Imagem da assinatura da profissional usada no documento (n\u00e3o \u00e9 assinatura digital qualificada)"
    },
    "documento_hash": {
      "type": "string",
      "description": "Hash SHA-256 do conte\u00fado do documento no momento da emiss\u00e3o"
    },
    "emitida_em": {
      "type": "string",
      "format": "date-time"
    },
    "cancelada_em": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_cancelamento": {
      "type": "string"
    },
    "versao": {
      "type": "number",
      "default": 1
    },
    "receita_anterior_id": {
      "type": "string"
    },
    "substituida_por_id": {
      "type": "string"
    },
    "pdf_url": {
      "type": "string"
    },
    "pdf_file_name": {
      "type": "string"
    },
    "exige_receituario_especial": {
      "type": "boolean",
      "default": false,
      "description": "Marca que o conte\u00fado exige receitu\u00e1rio de controle especial (n\u00e3o suprido por receita simples)"
    },
    "historico": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "acao": {
            "type": "string"
          },
          "data": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "patient_id",
    "patient_name",
    "data_emissao",
    "status"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}