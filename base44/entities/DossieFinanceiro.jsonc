{
  "name": "DossieFinanceiro",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "procedimento": {
      "type": "string"
    },
    "valor_total": {
      "type": "number"
    },
    "entrada": {
      "type": "number"
    },
    "num_parcelas": {
      "type": "number",
      "default": 1
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "pix",
        "dinheiro",
        "cartao_credito",
        "cartao_debito",
        "transferencia",
        "boleto",
        "link_pagamento",
        "outro"
      ]
    },
    "taxa_juros_pct": {
      "type": "number",
      "default": 2.44,
      "description": "Percentual de juros da maquininha (cart\u00e3o) aplicado ao valor total"
    },
    "absorver_juros": {
      "type": "boolean",
      "default": true,
      "description": "Se true, a cl\u00ednica absorve os juros (l\u00edquido = bruto \u2212 juros). Se false, os juros s\u00e3o repassados ao cliente (l\u00edquido = bruto integral)."
    },
    "valor_juros": {
      "type": "number",
      "description": "Valor monet\u00e1rio do juros calculado"
    },
    "valor_liquido": {
      "type": "number",
      "description": "Valor l\u00edquido que a cl\u00ednica recebe ap\u00f3s juros"
    },
    "status_financeiro": {
      "type": "string",
      "enum": [
        "pendente",
        "entrada_paga",
        "pago_parcial",
        "pago_integral",
        "aguardando_conferencia",
        "conferido",
        "em_atraso",
        "cancelado",
        "reembolsado"
      ],
      "default": "pendente"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date"
    },
    "observacoes": {
      "type": "string"
    },
    "comprovantes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "tipo_pagamento": {
            "type": "string"
          },
          "valor": {
            "type": "number"
          },
          "data_pagamento": {
            "type": "string"
          },
          "procedimento": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "data_upload": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "patient_id",
    "procedimento",
    "valor_total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}