{
  "name": "Supply",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "injetavel",
        "topico",
        "equipamento",
        "descartavel",
        "outros"
      ]
    },
    "brand": {
      "type": "string"
    },
    "unit": {
      "type": "string",
      "enum": [
        "ml",
        "mg",
        "un",
        "cx",
        "fr",
        "amp"
      ],
      "description": "Unidade de controle do estoque"
    },
    "unidade_consumo": {
      "type": "string",
      "enum": [
        "ml",
        "u",
        "mg",
        "un",
        "amp",
        "cx",
        "fr"
      ],
      "description": "Unidade usada no registro de consumo do procedimento (ex: mL para \u00e1cido hialur\u00f4nico, U para toxina)"
    },
    "conteudo_por_unidade": {
      "type": "number",
      "default": 1,
      "description": "Quanto da unidade de consumo existe em 1 unidade de estoque (ex: 1 mL por seringa, 100 U por frasco)"
    },
    "current_stock": {
      "type": "number",
      "default": 0
    },
    "minimum_stock": {
      "type": "number"
    },
    "cost_per_unit": {
      "type": "number"
    },
    "supplier": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "out_of_stock"
      ],
      "default": "active"
    },
    "requires_prescription": {
      "type": "boolean",
      "default": false
    },
    "storage_conditions": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "unit"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}